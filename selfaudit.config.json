        {
          "action": "click",
          "selector": "button:has-text(\"LINE\"), [class*=\"line\"]:has-text(\"LINE\")"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "assertNoDialog",
          "failMsg": "前端擋下並跳出提示"
        },
        {
          "action": "assertUrlMatches",
          "pattern": "access\\.line\\.me|line\\.me/oauth",
          "okMsg": "已正確導向 LINE 授權頁",
          "failMsg": "點擊後未導向 LINE"
