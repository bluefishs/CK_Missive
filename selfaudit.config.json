{
  "$schema": "./scripts/checks/selfaudit.schema.json",
  "_doc": "自我檢核設定（Phase 1 引擎化，2026-08-01）。引擎與配置分離：ui_flow_smoke / ui_page_sweep / ui_smoke_auth 零硬編碼，per-repo 差異全在此檔。跨專案移植時只需改這一份，不改引擎（引擎漂移由 sync-vendored drift gate 擋）。標準見 docs/architecture/SELF_AUDIT_EVOLUTION_STANDARD.md",
  "project": "CK_Missive",
  "base_url": "https://missive.cksurvey.tw",
  "auth": {
    "_doc": "檢核用臨時 session 的取得方式。各 repo 認證機制不同，故抽成 adapter。",
    "adapter": "docker_jwt",
    "container": "ck_missive_backend",
    "script_path": "/app/scripts/checks/ui_smoke_auth.py",
    "internal_url": "http://localhost:8001",
    "csrf_endpoint": "/api/secure-site-management/csrf-token",
    "session_minutes": 20,
    "jti_prefix": "ui-smoke-"
  },
  "page_sweep": {
    "_doc": "廣度掃描：讀路由定義檔，全站靜態路由走一遍。",
    "routes_source": "frontend/src/router/types.ts",
    "routes_pattern": "^\\s{2}([A-Z0-9_]+):\\s*'(/[^']*)'",
    "exclude": [
      "/",
      "/entry",
      "/login",
      "/register",
      "/forgot-password",
      "/reset-password",
      "/verify-email",
      "/mfa/verify",
      "/auth/line/callback",
      "/auth/line/bind-callback",
      "/404",
      "/api/docs",
      "/api-mapping",
      "/unified-form-demo",
      "/google-auth-diagnostic"
    ],
    "error_texts": [
      "載入失敗",
      "發生錯誤",
      "系統錯誤",
      "Something went wrong",
      "無法載入"
    ],
    "throttle_ms": 900,
    "mobile_probe": {
      "_doc": "行動版面觀測（2026-08-02）。既有廣度掃描固定 1440×900，手機上版面壞掉沒有任何機制會發現——而核銷的主要入口正是手機掃 QR。刻意**只觀測不告警**：表格設 scroll={{x}} 橫向捲動是刻意設計，一律判 FAIL 會產出整片噪音。採用的量已做鑑別力對照（手機 vs 桌面同頁比對）：/erp/quotations 708 vs 0、/documents 158 vs 0 → 手機獨有。另量過的『小於 32px 觸控目標數』手機 157/桌面 156＝無鑑別力，已捨棄不交付。",
      "enabled": true,
      "viewport": {
        "width": 390,
        "height": 844
      },
      "overflow_warn_px": 400,
      "routes": [
        "/erp/expenses",
        "/erp/quotations",
        "/erp/ledger",
        "/erp/assets",
        "/erp/operational",
        "/erp/financial-dashboard",
        "/erp/vendor-accounts",
        "/erp/client-accounts",
        "/documents",
        "/contract-cases",
        "/taoyuan/dispatch",
        "/calendar",
        "/kunge/ops"
      ]
    },
    "known_limitations": [
      {
        "route": "/admin/deployment",
        "match": "status of 503",
        "reason": "未配置 GITHUB_TOKEN（部署歷史功能未啟用）— 補 token 即可解除"
      }
    ]
  },
  "flows": [
    {
      "id": "line",
      "name": "LINE 登入（owner 回報：一選就出現登入錯誤）",
      "auth": false,
      "url": "/entry",
      "steps": [
        {
          "action": "waitFor",
          "selector": "button:has-text(\"LINE\")",
          "timeout": 15000
        },
        {
          "action": "click",
          "selector": "button:has-text(\"LINE\"), [class*=\"line\"]:has-text(\"LINE\")"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "assertNoDialog",
          "failMsg": "前端擋下並跳出提示"
        },
        {
          "action": "assertUrlMatches",
          "pattern": "access\\.line\\.me|line\\.me/oauth",
          "okMsg": "已正確導向 LINE 授權頁",
          "failMsg": "點擊後未導向 LINE"
        }
      ]
    },
    {
      "id": "quotation-expense",
      "name": "報價「費用核銷」列可點入（owner 回報兩次）",
      "auth": true,
      "url": "/erp/quotations/167",
      "steps": [
        {
          "action": "clickText",
          "text": "費用核銷"
        },
        {
          "action": "wait",
          "ms": 2000
        },
        {
          "action": "assertCount",
          "selector": "button:has-text(\"檢視\")",
          "min": 1,
          "failMsg": "沒有任何「檢視」按鈕（已核准紀錄將無法點入）"
        }
      ]
    },
    {
      "id": "ezbid-create-case",
      "name": "ezbid 標案有「一鍵建案」（owner 回報：無法建案）",
      "auth": true,
      "url": "/tender/ezbid/2227632",
      "steps": [
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "assertCount",
          "selector": "button:has-text(\"一鍵建案\")",
          "min": 1,
          "failMsg": "ezbid 標案頁沒有「一鍵建案」按鈕"
        },
        {
          "action": "assertCount",
          "selector": "button:has-text(\"收藏\")",
          "min": 1,
          "failMsg": "有建案鈕但缺收藏（與 PCC 頁設計不一致）"
        }
      ]
    },
    {
      "id": "contract-finance",
      "name": "承攬案件財務紀錄有資料（owner 回報：無法填報）",
      "auth": true,
      "url": "/contract-cases/187",
      "steps": [
        {
          "action": "clickText",
          "text": "財務紀錄"
        },
        {
          "action": "wait",
          "ms": 2000
        },
        {
          "action": "assertTextAbsent",
          "text": "尚無 ERP 報價紀錄",
          "failMsg": "財務紀錄仍是空的（case_code / 報價未接通）"
        }
      ]
    },
    {
      "id": "receipt-image",
      "name": "核銷收據影像載得出來（owner 回報：看不到）",
      "auth": true,
      "url": "/erp/expenses/6",
      "steps": [
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "clickText",
          "text": "收據影像"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "assertTextAbsent",
          "text": "無收據影像",
          "failMsg": "詳情頁顯示「無收據影像」"
        },
        {
          "action": "assertCount",
          "selector": "img[src^=\"blob:\"], img[alt*=\"收據\"]",
          "min": 1,
          "failMsg": "找不到收據影像元素"
        }
      ]
    },
    {
      "id": "kunge",
      "name": "坤哥意識體服務鏈（對話/心智/進化/圖譜/運維五主軸）",
      "auth": true,
      "url": "/kunge",
      "steps": [
        {
          "action": "wait",
          "ms": 3000
        },
        {
          "action": "assertTextsPresent",
          "texts": [
            "對話",
            "心智",
            "進化",
            "圖譜",
            "運維"
          ],
          "failMsg": "缺少主軸"
        },
        {
          "action": "clickText",
          "text": "進化"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "assertTextAbsent",
          "text": "載入失敗",
          "failMsg": "進化分頁載入失敗（學習閉環資料鏈斷）"
        }
      ]
    },
    {
      "id": "account-record-entry",
      "name": "應收填報：從報價單點入 → 導向獨立頁 → 表單渲染（入口與頁面一次驗完）",
      "auth": true,
      "url": "/erp/quotations/167",
      "steps": [
        {
          "action": "wait",
          "ms": 2600
        },
        {
          "action": "clickText",
          "text": "應收帳款"
        },
        {
          "action": "wait",
          "ms": 1800
        },
        {
          "action": "assertCount",
          "selector": "button:has-text(\"新增應收\")",
          "min": 1,
          "failMsg": "應收帳款分頁沒有「新增應收」按鈕（入口斷了）"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"新增應收\")"
        },
        {
          "action": "wait",
          "ms": 2600
        },
        {
          "action": "assertUrlMatches",
          "pattern": "accounts/receivable/create",
          "okMsg": "已導向獨立填報頁",
          "failMsg": "點了新增卻沒有導向填報頁"
        },
        {
          "action": "assertTextsPresent",
          "texts": [
            "新增應收",
            "請款日期",
            "請款金額"
          ],
          "failMsg": "導向了但表單沒渲染出來"
        },
        {
          "action": "assertCount",
          "selector": "button:has-text(\"返回\")",
          "min": 1,
          "failMsg": "缺返回鍵——獨立頁若無返回，使用者會被困在填報頁"
        }
      ]
    },
    {
      "id": "mobile-create",
      "name": "行動版核銷建立頁（重點摘要 + 批次連續）",
      "auth": true,
      "url": "/erp/expenses/create?case_code=CK2026_FN_01_001",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "steps": [
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "clickText",
          "text": "手動"
        },
        {
          "action": "wait",
          "ms": 1200
        },
        {
          "action": "click",
          "selector": "button:has-text(\"開始填寫\")"
        },
        {
          "action": "wait",
          "ms": 2000
        },
        {
          "action": "assertCount",
          "selector": "button:has-text(\"建立並繼續\")",
          "min": 1,
          "failMsg": "沒有「建立並繼續掃下一張」（手機批次會被中斷）"
        }
      ]
    },
    {
      "id": "ops-morning-report",
      "name": "運維「營運 › 晨報與推播」tab（獨立後的核心資訊）",
      "auth": true,
      "url": "/kunge/ops",
      "steps": [
        {
          "action": "wait",
          "ms": 3200
        },
        {
          "action": "assertTextsPresent",
          "texts": [
            "營運",
            "系統",
            "AI 診斷"
          ],
          "failMsg": "ops 外層三組沒有渲染（分組結構斷了）"
        },
        {
          "action": "assertTextsPresent",
          "texts": [
            "晨報與推播",
            "今日晨報",
            "LINE 月推播配額",
            "近 7 日派送狀態"
          ],
          "failMsg": "晨報與推播 tab 的核心區塊沒渲染出來"
        },
        {
          "action": "assertTextAbsent",
          "text": "配額查不到",
          "failMsg": "LINE 配額查詢失敗（Redis 或後端欄位問題）"
        }
      ]
    }
  ],
  "output": {
    "_doc": "沿用本 repo 既有慣例 wiki/memory/integration-health/ —— producer registry 的 file_fresh 與每日告警已綁在這兩個路徑上，不可為了「跟別的 repo 一致」而改動（改了等於把既有告警接線切斷）",
    "flow_result": "wiki/memory/integration-health/ui-flow.json",
    "sweep_result": "wiki/memory/integration-health/ui-sweep.json"
  },
  "entry_script": "scripts/checks/run_ui_smoke.sh",
  "schedule_installer": "scripts/checks/.shared-selfaudit/install-selfaudit-task.ps1",
  "schedule_flow_time": "04:15",
  "schedule_sweep_time": "04:30",
  "extra_tasks": [
    {
      "suffix": "CapabilityUsage",
      "entry": "scripts/checks/run_capability_snapshot.sh",
      "time": "04:50",
      "args": ""
    }
  ]
}