{
  "$schema": "./scripts/checks/selfaudit.schema.json",
  "_doc": "自我檢核設定（Phase 1 引擎化，2026-08-01）。引擎與配置分離：ui_flow_smoke / ui_page_sweep / ui_smoke_auth 零硬編碼，per-repo 差異全在此檔。跨專案移植時只需改這一份，不改引擎（引擎漂移由 sync-vendored drift gate 擋）。標準見 docs/architecture/SELF_AUDIT_EVOLUTION_STANDARD.md",
  "project": "CK_Missive",
  "base_url": "https://missive.cksurvey.tw",
  "auth": {
    "_doc": "檢核用臨時 session 的取得方式。各 repo 認證機制不同，故抽成 adapter。",
    "adapter": "docker_jwt",
    "container": "ck_missive_backend",
    "script_path": "/app/scripts/checks/ui_smoke_auth.py",
    "internal_url": "http://localhost:8001",
    "csrf_endpoint": "/api/secure-site-management/csrf-token",
    "session_minutes": 20,
    "jti_prefix": "ui-smoke-"
  },
  "page_sweep": {
    "_doc": "廣度掃描：讀路由定義檔，全站靜態路由走一遍。",
    "routes_source": "frontend/src/router/types.ts",
    "routes_pattern": "^\\s{2}([A-Z0-9_]+):\\s*'(/[^']*)'",
    "exclude": [
      "/",
      "/entry",
      "/login",
      "/register",
      "/forgot-password",
      "/reset-password",
      "/verify-email",
      "/mfa/verify",
      "/auth/line/callback",
      "/auth/line/bind-callback",
      "/404",
      "/api/docs",
      "/api-mapping",
      "/unified-form-demo",
      "/google-auth-diagnostic"
    ],
    "error_texts": [
      "載入失敗",
      "發生錯誤",
      "系統錯誤",
      "Something went wrong",
      "無法載入"
    ],
    "throttle_ms": 900,
    "mobile_probe": {
      "_doc": "行動版面觀測（2026-08-02）。既有廣度掃描固定 1440×900，手機上版面壞掉沒有任何機制會發現——而核銷的主要入口正是手機掃 QR。刻意**只觀測不告警**：表格設 scroll={{x}} 橫向捲動是刻意設計，一律判 FAIL 會產出整片噪音。採用的量已做鑑別力對照（手機 vs 桌面同頁比對）：/erp/quotations 708 vs 0、/documents 158 vs 0 → 手機獨有。另量過的『小於 32px 觸控目標數』手機 157/桌面 156＝無鑑別力，已捨棄不交付。 2026-08-04：新增 detail_routes —— 原本只吃靜態路由，帶 :id 的詳情頁**結構上被排除、從未量過**，而詳情頁正是行動裝置最常檢視的地方；實測 /contract-cases/:id 每個分頁表格外溢 434~534px（390px 螢幕看不到一半）。",
      "enabled": true,
      "viewport": {
        "width": 390,
        "height": 844
      },
      "overflow_warn_px": 400,
      "routes": [
        "/erp/expenses",
        "/erp/quotations",
        "/erp/ledger",
        "/erp/assets",
        "/erp/operational",
        "/erp/financial-dashboard",
        "/erp/vendor-accounts",
        "/erp/client-accounts",
        "/documents",
        "/contract-cases",
        "/taoyuan/dispatch",
        "/calendar",
        "/kunge/ops"
      ],
      "detail_routes": [
        "/documents/2689",
        "/erp/quotations/168",
        "/erp/expenses/10",
        "/pm/cases/244",
        "/contract-cases/187"
      ]
    },
    "known_limitations": [
      {
        "route": "/admin/deployment",
        "match": "status of 503|HTTP 503",
        "reason": "未配置 GITHUB_TOKEN（部署歷史功能未啟用）— 補 token 即可解除 —— 設 token 即可解。註：match 需同時涵蓋 console 訊息（status of 503）與回應層診斷（HTTP 503 <url>）兩種格式；2026-08-09 新增回應層診斷後，只寫前者會讓這條降級規則失效（降級要求「所有問題都符合」）。"
      }
    ]
  },
  "flows": [
    {
      "id": "line",
      "name": "LINE 登入（owner 回報：一選就出現登入錯誤）",
      "auth": false,
      "url": "/entry",
      "steps": [
        {
          "action": "waitFor",
          "selector": "button:has-text(\"LINE\")",
          "timeout": 15000
